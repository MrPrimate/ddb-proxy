# Build from the repository root: docker build -f docker/dockerfile -t ddb-proxy .
FROM node:24-alpine3.24 AS build

WORKDIR /srv
COPY package.json yarn.lock ./
RUN ["yarn", "install", "--production", "--frozen-lockfile"]
COPY *.js LICENSE ./

FROM node:24-alpine3.24 AS ddb-proxy

ENV NODE_ENV=production
EXPOSE 3000

WORKDIR /srv

COPY --from=build /srv /srv
USER node
CMD [ "node", "index.js" ]
